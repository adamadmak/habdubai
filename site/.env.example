# The Laravel API, with /api at the end. The website's server calls it; browsers never do.
API_URL=http://localhost:8000/api

# This website's own public address, for links in metadata, the sitemap and share buttons.
SITE_URL=http://localhost:3001

# The same value as SITE_API_KEY on the API (24+ characters). With it the API counts rate
# limits per visitor instead of treating the whole website as one visitor.
# SITE_API_KEY=

# This server runs the API's scheduler once a minute (the host has no cron), at {API_URL}/system/tick.
# Only needed to point it elsewhere, or when a tick token is saved on the admin's Settings.
# TICK_URL=https://habesha-api.example.com/api/system/tick
# TICK_TOKEN=the token saved on Settings
